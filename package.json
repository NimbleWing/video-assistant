{
  "name": "rouvideo-assistant",
  "version": "1.14.0",
  "private": true,
  "type": "module",
  "description": "肉视频助手 Chrome 扩展 — 开发工具链（测试/静态检查），扩展本体无运行时依赖",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
